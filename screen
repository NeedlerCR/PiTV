#!/usr/bin/env bash
# /usr/local/bin/screen — PiTV CLI wrapper

set -euo pipefail

FIFO="/tmp/tv_menu.fifo"
REMOTE_SCRIPT="/opt/pitv/remote.py"

usage() {
    cat >&2 << 'USAGE'
Usage: screen <command> [arg]

Navigation:
  screen up | down | left | right | enter | back | clear

Screensavers (optional duration in seconds):
  screen fire [seconds]
  screen clock [seconds]
  screen matrix [seconds]

Other modes:
  screen mirror
  screen game <snake|tetris|invaders|breakout|shooter|tictactoe>

Controller:
  screen controller        scan for Bluetooth controller (60 seconds)

Player PINs (unlock locked games; the log records who played):
  screen pin assign <name>              create/show a person's PIN
  screen pin assign <name> custom <pin> set a specific 6-digit PIN
  screen pin list                       list everyone's PIN
  screen pin remove <name>              delete a person's PIN
  screen pin rename <old> <new>         rename a person

System:
  screen version                        show the PiTV version
  screen unlock authorise <code>        clear a full lockdown

Guest web portal (port 8080, only when Home 'Guest Mode' is on):
  screen guest password set <name> <pw> create/update a guest login
  screen guest list                     list guests + their NFC links
  screen guest remove <name>            delete a guest
  screen guest kick all                 sign out ALL guests immediately
  screen pin guest rotate all           fresh player PINs for all guests

Admin web portal (http://raspberrypi.local, username + password):
  screen admin password set <user> <pw> create/update an admin login
  screen admin list                     list admins
  screen admin remove <user>            delete an admin

SSH keyboard remote:
  screen remote on         interactive forwarder (ESC to exit)
  screen remote off        kill a background remote session

Log:
  screen log               show last 30 lines
  screen log tail          follow live (Ctrl+C to stop)
  screen log show          print whole log
  screen log clear         clear log on disk and in memory
  screen log copy          save timestamped copy to home directory
USAGE
    exit 1
}

_check_fifo() {
    if [[ ! -p "$FIFO" ]]; then
        echo "Error: FIFO not found at $FIFO — is tv_menu.py running?" >&2
        echo "       Check: systemctl status pitv-menu" >&2
        exit 1
    fi
}

_send() {
    _check_fifo
    timeout 3 bash -c "echo $(printf '%q' "$1") > '$FIFO'" 2>/dev/null \
        || { echo "Error: timeout writing to FIFO" >&2; exit 1; }
}

_send_raw() {
    _check_fifo
    timeout 3 bash -c "echo \"$1\" > '$FIFO'" 2>/dev/null \
        || { echo "Error: timeout writing to FIFO" >&2; exit 1; }
}

[[ $# -eq 0 ]] && usage

CMD="${1,,}"

case "$CMD" in
    up|down|left|right|back|clear)
        _send "${CMD^^}"
        ;;

    enter)
        _send "SELECT"
        ;;

    pin)
        shift
        # `screen pin guest rotate all` rotates all guest PINs.
        if [[ "${1:-}" == "guest" && "${2:-}" == "rotate" ]]; then
            exec python3 /opt/pitv/guest-admin.py rotate
        fi
        exec python3 /opt/pitv/pin-admin.py "$@"
        ;;

    guest)
        shift
        exec python3 /opt/pitv/guest-admin.py "$@"
        ;;

    admin)
        case "${2:-}" in
            password)
                if [[ "${3:-}" == "set" && -n "${4:-}" && -n "${5:-}" ]]; then
                    exec python3 /opt/pitv/guest-admin.py admin-set "${4}" "${5}"
                fi
                echo "Usage: screen admin password set <username> <password>" >&2
                exit 1 ;;
            list)   exec python3 /opt/pitv/guest-admin.py admin-list ;;
            remove) exec python3 /opt/pitv/guest-admin.py admin-remove "${3:-}" ;;
            *) echo "Usage: screen admin <password set|list|remove> ..." >&2; exit 1 ;;
        esac
        ;;

    version)
        cat /opt/pitv/VERSION 2>/dev/null || echo "unknown"
        ;;

    unlock)
        if [[ "${2:-}" == "authorise" && -n "${3:-}" ]]; then
            _send_raw "UNLOCK ${3}"
            echo "Authorisation sent."
        else
            echo "Usage: screen unlock authorise <emergency code>" >&2
            exit 1
        fi
        ;;

    fire|clock|matrix)
        DUR="${2:-INDEFINITE}"
        _send "RUN ${CMD^^} ${DUR}"
        ;;

    mirror)
        _send "RUN MIRROR INDEFINITE"
        ;;

    game)
        KEY="${2:-}"
        [[ -z "$KEY" ]] && { echo "Usage: screen game <name>" >&2; exit 1; }
        case "${KEY,,}" in
            inv|invaders|space)   KEY="INVADERS"   ;;
            tet|tetris)           KEY="TETRIS"      ;;
            snake|sn)             KEY="SNAKE"       ;;
            shoot|shooter|bsu)    KEY="SHOOTER"     ;;
            break|breakout)       KEY="BREAKOUT"    ;;
            ttt|tictactoe|toe|noughts|nc) KEY="TICTACTOE" ;;
            *)                    KEY="${KEY^^}"    ;;
        esac
        _send_raw "RUN GAME INDEFINITE ${KEY}"
        ;;

    controller)
        _send "SCAN_CONTROLLER"
        echo "Scanning for Bluetooth controller for 60 seconds..."
        echo "Make sure your controller is in pairing/connection mode."
        ;;

    remote)
        case "${2:-}" in
            on)
                [[ ! -f "$REMOTE_SCRIPT" ]] && {
                    echo "Error: $REMOTE_SCRIPT not found" >&2; exit 1; }
                _check_fifo
                exec python3 "$REMOTE_SCRIPT"
                ;;
            off)
                pkill -f "remote.py" 2>/dev/null \
                    && echo "Remote session stopped." \
                    || echo "No remote session found."
                ;;
            *)
                echo "Usage: screen remote on|off" >&2; exit 1 ;;
        esac
        ;;

    log)
        case "${2:-}" in
            tail)
                tail -f /tmp/pitv.log
                ;;
            show)
                cat /tmp/pitv.log 2>/dev/null || echo "No log yet."
                ;;
            clear)
                > /tmp/pitv.log 2>/dev/null || true
                _send "LOG_CLEAR"
                echo "Log cleared."
                ;;
            copy)
                DEST="$HOME/pitv-$(date +%Y%m%d-%H%M%S).log"
                cp /tmp/pitv.log "$DEST" 2>/dev/null \
                    && echo "Log saved to $DEST" \
                    || echo "No log file found."
                ;;
            "")
                tail -n 30 /tmp/pitv.log 2>/dev/null || echo "No log yet."
                ;;
            *)
                echo "Usage: screen log [tail|show|clear|copy]" >&2; exit 1 ;;
        esac
        ;;

    *)
        echo "Unknown command: $CMD" >&2
        usage
        ;;
esac
